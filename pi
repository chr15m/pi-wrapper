#!/usr/bin/env bash
set -e

TARGET_DIR="$(pwd)"
SCRIPT_DIR="$(dirname "$(realpath "$0")")"

export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"

NODE_BIN="$(dirname "$(nvm which 22)")"
NODE_DIR="$(dirname "$NODE_BIN")"

mkdir -p "$HOME/.pi"

BWRAP_ARGS=(
  --ro-bind /usr /usr
  --ro-bind /bin /bin
  --ro-bind /lib /lib
)

[ -d /lib64 ] && BWRAP_ARGS+=(--ro-bind /lib64 /lib64)
[ -f /etc/resolv.conf ] && BWRAP_ARGS+=(--ro-bind /etc/resolv.conf /etc/resolv.conf)
[ -d /etc/ssl ] && BWRAP_ARGS+=(--ro-bind /etc/ssl /etc/ssl)
[ -d /etc/alternatives ] && BWRAP_ARGS+=(--ro-bind /etc/alternatives /etc/alternatives)

BWRAP_ARGS+=(
  --proc /proc
  --dev /dev
  --tmpfs /tmp
  --ro-bind "$NODE_DIR" "$NODE_DIR"
  --bind "$SCRIPT_DIR" "$SCRIPT_DIR"
  --bind "$HOME/.pi" "$HOME/.pi"
  --bind "$TARGET_DIR" "$TARGET_DIR"
)

[ -f "$HOME/.gitconfig" ] && BWRAP_ARGS+=(--ro-bind "$HOME/.gitconfig" "$HOME/.gitconfig")
[ -f "$HOME/.gitignore_global" ] && BWRAP_ARGS+=(--ro-bind "$HOME/.gitignore_global" "$HOME/.gitignore_global")

BWRAP_ARGS+=(
  --chdir "$TARGET_DIR"
  --setenv PATH "$SCRIPT_DIR/bin:$NODE_BIN:/usr/local/bin:/usr/bin:/bin"
  --unshare-all
  --share-net
)

exec bwrap "${BWRAP_ARGS[@]}" "$SCRIPT_DIR/node_modules/.bin/pi" \
  --append-system-prompt "$SCRIPT_DIR/AGENTS.md" "$@"
